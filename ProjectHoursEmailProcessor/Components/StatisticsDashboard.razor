@using System.Diagnostics

<FluentCard>
    <FluentStack Orientation="Orientation.Vertical">
        <h2 style="margin-bottom:0px">Statistics</h2>
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8px">
            <div>
                <FluentDatePicker Label="Start Date"
                                  @bind-Value="@startDate"
                                  @bind-Value:after="SetFilterItems"
                                  RenderStyle="DatePickerRenderStyle.Native" />
            </div>
            <div>
                <FluentDatePicker Label="End Date"
                                  @bind-Value="@endDate"
                                  @bind-Value:after="SetFilterItems"
                                  RenderStyle="DatePickerRenderStyle.Native" />
            </div>
        </FluentStack>
    </FluentStack>

    <FluentDataGrid Items="items" RowSize="DataGridRowSize.Small" StripedRows="true">
        <PropertyColumn Property="p => p.MentorName" Title="Mentor Name" Sortable="true" IsDefaultSortColumn="true" />
        <PropertyColumn Property="p => p.AverageSessionLength" Title="Average Session Length (Hours)" Sortable="true" />
        <PropertyColumn Property="p => p.AverageSessionsPerBusiness" Title="Average Sessions Per Business" Sortable="true" />
        <PropertyColumn Property="p => p.TotalNumberOfApprovedSessions" Title="Total Number Of Approved Sessions" Sortable="true" />
        <PropertyColumn Property="p => p.TotalHoursApproved" Title="Total Hours Approved" Sortable="true" />
        <PropertyColumn Property="p => p.NumberOfBusinesses" Title="Total Number Of Businesses" Sortable="true" />
    </FluentDataGrid>
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public AggregatedEmailData AggregatedEmailData { get; set; }
    private AggregatedEmailData? _prevAggregatedEmailData;

    private IQueryable<MentorStatistics> items = default!;

    private DateOnly? startDate;
    private DateOnly? endDate;

    protected override void OnParametersSet()
    {
        Debug.Assert(AggregatedEmailData is not null);
        if (_prevAggregatedEmailData == AggregatedEmailData)
        {
            return;
        }

        _prevAggregatedEmailData = AggregatedEmailData;

        SetFilterItems();
    }

    private void SetFilterItems()
    {
        IEnumerable<ApprovedHoursEmail> approvedHoursEmails = AggregatedEmailData.ApprovedHoursEmails;

        if (startDate.HasValue)
        {
            approvedHoursEmails = approvedHoursEmails.Where(x => x.SessionDate >= startDate);
        }

        if (endDate.HasValue)
        {
            approvedHoursEmails = approvedHoursEmails.Where(x => x.SessionDate <= endDate);
        }

        items = approvedHoursEmails.GroupBy(x => x.MentorName, StringComparer.CurrentCultureIgnoreCase)
            .Select(x => new MentorStatistics(x, x.Key))
            .OrderBy(x => x.MentorName)
            .ToList()
            .AsQueryable();
    }

    private sealed class MentorStatistics
    {
        public IEnumerable<ApprovedHoursEmail> ApprovedHoursEmails { get; private set; }
        public string MentorName { get; private set; }
        public int NumberOfBusinesses { get; }
        public int TotalNumberOfApprovedSessions => ApprovedHoursEmails.Count();
        public double AverageSessionsPerBusiness { get; }
        public double AverageSessionLength { get; }
        public double TotalHoursApproved { get; }

        public MentorStatistics(IEnumerable<ApprovedHoursEmail> approvedHoursEmails, string mentorName)
        {
            ApprovedHoursEmails = approvedHoursEmails;
            MentorName = mentorName.ToCapitaliseEachWord();
            NumberOfBusinesses = GetNumberOfBusinesses(approvedHoursEmails);
            AverageSessionsPerBusiness = GetAverageNumberSessionsPerBusiness(approvedHoursEmails);
            AverageSessionLength = GetAverageSessionLength(approvedHoursEmails);
            TotalHoursApproved = approvedHoursEmails.Sum(x => x.CompletedHours);
        }

        private static int GetNumberOfBusinesses(IEnumerable<ApprovedHoursEmail> aggregatedEmailData)
        {
            return aggregatedEmailData
                .DistinctBy(x => x.BusinessName, StringComparer.CurrentCultureIgnoreCase)
                .Count();
        }

        private static double GetAverageNumberSessionsPerBusiness(IEnumerable<ApprovedHoursEmail> aggregatedEmailData)
        {
            var average = aggregatedEmailData
                .GroupBy(x => x.BusinessName)
                .Average(g => g.Count());

            return Math.Round(average, 1, MidpointRounding.AwayFromZero);
        }

        private static double GetAverageSessionLength(IEnumerable<ApprovedHoursEmail> aggregatedEmailData)
        {
            var average = aggregatedEmailData.Average(x => x.CompletedHours);
            return Math.Round(average, 1, MidpointRounding.AwayFromZero);
        }
    }
}
